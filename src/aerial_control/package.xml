<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aerial_control</name>
  <version>0.1.0</version>
  <description>
    PX4 飞控 ROS2 控制节点：通过 USB 转串口与 PX4 飞控建立 MAVLink 连接，
    提供状态发布、arm/disarm 服务、OFFBOARD 模式切换、速度控制订阅。
  </description>
  <maintainer email="dev@example.com">ros2_working_place</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-pymavlink</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

