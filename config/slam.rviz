Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 600
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Show Axes: true
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Topic:
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Value: /map
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_updates
      Alpha: 0.7
      Color Scheme: map
      Draw Behind: false
      Enabled: true
      Update Rate: 1
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Topic:
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Value: /scan
      Alpha: 1
      Autocompute Intensity Bounds: true
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Max Intensity: 4096
      Min Intensity: 0
      Size (Pixels): 3
      Size (m): 0.05
      Style: Flat Squares
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: PointCloud2
      Topic:
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Value: /camera/depth/points
      Alpha: 1
      Autocompute Intensity Bounds: true
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Max Intensity: 4096
      Min Intensity: 0
      Size (Pixels): 3
      Size (m): 0.05
      Style: Flat Squares
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: RobotPose
      Topic:
        Depth: 5
        Reliability Policy: Reliable
        Value: /pose
      Alpha: 1
      Color: 255; 25; 0
      Head Length: 0.3
      Head Radius: 0.1
      Shaft Length: 0.7
      Shaft Radius: 0.05
      Shape: Arrow
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo: true
      Invert Z Axis: false
      Name: TopDownOrtho
      Near Clip Distance: 0.01
      Scale: 50
      Target Frame: <Fixed Frame>
      X: 0
      Y: 0
      Yaw: 0
      Pitch: 0
      Angle: 0
      Distance: 10
Window Geometry:
  Displays:
    collapsed: false
  Height: 700
  Hide Left Dock: false
  Width: 1000
  X: 50
  Y: 50
